+
+def matrix(output):
+    """Resolve inherited configs and expose budget differences, never hide them."""
+    rows=[]
+    for path in sorted((PROJECT_ROOT/'configs/ablations').glob('A*.yaml')):
+        cfg=experiment_config(path);pk=cfg['sampling']['mode']=='pk'
+        from datasets.common import mill_records
+        train_count=len(mill_records(project_path(cfg['data']['mill_root']),'train',None))
+        physical=cfg['sampling']['p']*cfg['sampling']['k'] if pk else cfg['triplet_batch_size']*3
+        exposures=cfg['sampling']['images_per_epoch'] if pk else train_count*3
+        micro=(exposures+physical-1)//physical
+        updates=(micro+cfg['accumulation_steps']-1)//cfg['accumulation_steps']
+        rows.append(dict(variant=cfg['variant'],config=path.relative_to(PROJECT_ROOT).as_posix(),
+            affine_mode=cfg['model']['affine_mode'],local_std=cfg['model']['local_init_std'],
+            gate=cfg['model']['residual_gate'],sampler=cfg['sampling']['mode'],miner=cfg['loss']['mining_mode'],
+            physical_microbatch_images=physical,gradient_accumulation_steps=cfg['accumulation_steps'],
+            effective_images_per_full_update=physical*cfg['accumulation_steps'],
+            same_level_negative_candidates_per_anchor=cfg['sampling']['p']-1 if pk else '1 at triplet batch=1',
+            epoch_image_exposures=exposures,attempted_updates_per_epoch=updates,
+            exposures_at_100_epochs=exposures*100,attempts_at_100_epochs=updates*100,
+            equal_5000_full_update_exposures_theoretical=5000*physical*cfg['accumulation_steps'],
+            equal_update_note='Full-window arithmetic only; natural epoch tails and AMP skips require summing actual update logs.',
+            note='PK repeats content/files; final tail smaller; no queue' if pk else 'each low once as anchor; p/n may repeat'))
+    write_csv(output,rows);print(f'MATRIX: {output}',flush=True)
+
+
+def diagnose(args):
+    """Explicit smoke diagnostic option cannot create formal summary.csv."""
+    from datasets.paired_dataset import ManifestPairedDataset
+    from engine.condition_diagnostics import run_condition_diagnostics
+    cfg=experiment_config(args.config);assert_environment(cfg)
+    if active_project_runs():raise RuntimeError('A project run is active; diagnosis postponed.')
+    state=load_checkpoint(args.checkpoint)
+    hashes=manifest_identity(cfg)
+    (validate_checkpoint if args.allow_smoke else validate_formal_checkpoint)(state,cfg,hashes)
+    seed_everything(cfg['seed']);torch.set_num_threads(cfg.get('cpu_threads',4))
+    from utils.runtime import choose_device
+    model=SDDNetV1(**model_options(cfg)).to(choose_device(cfg['device'])).eval()
+    model.load_state_dict(state['model'],strict=True)
+    data=ManifestPairedDataset(project_path(cfg['data']['mill_root']),run_path(cfg)/'metadata/mill.csv','validation')
+    output=project_path(args.output)
+    if output.exists() and any(output.iterdir()):raise FileExistsError('Diagnostic output must be new/empty; preserve earlier results.')
+    result=run_condition_diagnostics(model,data,output,size=cfg['diagnostics']['patch_size'],
+        contents=cfg['diagnostics'].get('condition_contents',3),seed=cfg['seed'],
+        provenance=dict(checkpoint=str(project_path(args.checkpoint)),sha256=file_hash(project_path(args.checkpoint)),
+                        run_kind=state.get('run_kind'),variant=state.get('variant','historical bounded baseline'),
+                        epoch=state['completed_epoch'],optimizer_updates=state['optimizer_updates']))
+    print(result,flush=True)
+
+
+def memory_check(args):
+    """One successful REAL optimizer update on a disposable model, not a run resume."""
+    from engine.training import Trainer
+    from scripts.prepare_data import prepare_data
+    cfg=experiment_config(args.config);assert_environment(cfg)
+    output=project_path(args.output)
+    if output.exists():raise FileExistsError('Preserve the previous memory measurement; choose a new output.')
+    if active_project_runs():raise RuntimeError('A project run is active; no memory probe started.')
+    cfg['run_dir']=str(output.parent/('memory_fixture_'+output.stem))
+    write_json(output.with_suffix('.config.json'),cfg)
+    result=dict(variant=cfg['variant'],patch_size=cfg['patch_size'],status='SKIP',reason='CUDA unavailable',
+                disposable_model=True,formal_training_started=False)
+    if not torch.cuda.is_available():write_json(output,result);return
+    cfg['device']='cuda';cfg['amp']=True
+    result.update(GPU=torch.cuda.get_device_name(),total_bytes=torch.cuda.get_device_properties(0).total_memory,
+                  free_before_bytes=torch.cuda.mem_get_info()[0])
+    try:
+        prepare_data(cfg)
+        trainer=Trainer(cfg);losses,count=trainer.epoch(1,max_updates=1)
+        result.update(status='PASS',reason='',optimizer_updates=trainer.optimizer_updates,
+            attempted_updates=trainer.attempted_updates,AMP_overflows=trainer.overflows,amp=trainer.use_amp,
+            physical_microbatch_images=trainer.logs[-1]['physical_microbatch_images'],
+            gradient_accumulation_steps=cfg['accumulation_steps'],
+            effective_images_per_update=trainer.logs[-1]['effective_images_this_window'],
+            peak_allocated_bytes=trainer.peak_memory,peak_reserved_bytes=torch.cuda.max_memory_reserved(),
+            image_exposures=trainer.image_exposures,coverage=trainer.last_coverage,losses=losses)
+        del trainer
+    except torch.cuda.OutOfMemoryError as error:
+        result.update(status='OOM',reason=str(error),peak_allocated_bytes=torch.cuda.max_memory_allocated(),
+                      peak_reserved_bytes=torch.cuda.max_memory_reserved())
+    except Exception as error:
+        result.update(status='FAIL',reason=f'{type(error).__name__}: {error}')
+        write_json(output,result);raise
+    finally:torch.cuda.empty_cache()
+    write_json(output,result);print(result,flush=True)
+
+
+def main(argv=None):
+    parser=argparse.ArgumentParser(description=__doc__);sub=parser.add_subparsers(dest='command',required=True)
+    m=sub.add_parser('matrix');m.add_argument('--output',default='reports/ablation_matrix.csv')
+    c=sub.add_parser('compare');c.add_argument('--candidate',required=True);c.add_argument('--control',required=True);c.add_argument('--output',required=True)
+    for name in ('diagnose','memory-check'):
+        p=sub.add_parser(name);p.add_argument('--config',required=True);p.add_argument('--output',required=True)
+        if name=='diagnose':p.add_argument('--checkpoint',required=True);p.add_argument('--allow-smoke',action='store_true')
+    args=parser.parse_args(argv)
+    if args.command=='matrix':matrix(project_path(args.output))
+    elif args.command=='compare':
+        from utils.io import read_csv
+        from utils.ablation_metrics import compare_control
+        directory=project_path(args.output)
+        if directory.exists() and any(directory.iterdir()):raise FileExistsError('Use a new comparison directory.')
+        rows,summary=compare_control(read_csv(project_path(args.candidate)),read_csv(project_path(args.control)))
+        summary.update(candidate_csv_sha256=file_hash(project_path(args.candidate)),control_csv_sha256=file_hash(project_path(args.control)))
+        write_csv(directory/'per_image_vs_control.csv',rows);write_json(directory/'summary_vs_control.json',summary)
+    elif args.command=='diagnose':diagnose(args)
+    else:memory_check(args)
+
+
+if __name__=='__main__':main()
