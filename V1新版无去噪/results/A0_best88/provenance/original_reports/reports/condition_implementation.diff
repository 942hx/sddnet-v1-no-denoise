+        improvement_image_fraction=float(np.mean(values>0)),decline_image_fraction=float(np.mean(values<0)),
+        cluster_bootstrap_ci95_low=float(np.quantile(samples,.025)),cluster_bootstrap_ci95_high=float(np.quantile(samples,.975)),
+        bootstrap_unit='full content_id (verified group_id if provided)',bootstrap_clusters=len(groups),bootstrap_seed=seed)
