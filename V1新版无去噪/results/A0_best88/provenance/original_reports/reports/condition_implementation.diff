+"""Lazy P-content/K-level physical microbatches; no image cache or feature queue."""
+import math
+import random
+from collections import defaultdict
+import torch
+from torch.utils.data import Dataset
+from .common import mill_records, load_rgb, transform_pair
+
+
+def take_microbatch(batch):
+    """Top-level collate for Windows spawn; each Dataset item is one PK batch."""
+    if len(batch)!=1: raise ValueError('PK loader batch_size must be one microbatch.')
+    return batch[0]
+
+
+class MILLPKDataset(Dataset):
+    """An epoch is a specified image-exposure budget, not one pass per low file.
+
+    The final physical batch can have fewer contents, but retains K levels and
+    synchronized geometry per content. Plans are deterministic from epoch/index.
+    """
+    def __init__(self,root,metadata,patch_size=256,p=4,k=2,images_per_epoch=900,seed=42,augment=True):
+        self.records=mill_records(root,'train',metadata)
+        self.patch_size,self.p,self.k=int(patch_size),int(p),int(k)
+        self.images_per_epoch,self.seed=int(images_per_epoch),int(seed)
+        self.augment,self.epoch=augment,1
+        self.by_scene=defaultdict(dict)
+        for i,r in enumerate(self.records): self.by_scene[r.content_id][r.level]=i
+        self.scenes=sorted(self.by_scene)
+        self.levels=sorted(set.intersection(*(set(v) for v in self.by_scene.values())))
+        if p<2 or k<2 or p>len(self.scenes) or len(self.levels)<k:
+            raise ValueError('PK needs P>=2 distinct contents and K>=2 shared verified levels.')
+        if images_per_epoch<p*k or images_per_epoch%k:
+            raise ValueError('PK exposure budget must be >=P*K and divisible by K.')
+
+    def __len__(self): return math.ceil(self.images_per_epoch/(self.p*self.k))
+    def set_epoch(self,epoch): self.epoch=int(epoch)
+    def batch_images(self,index): return min(self.p*self.k,self.images_per_epoch-index*self.p*self.k)
+
+    def plan(self,index):
+        rng=random.Random(self.seed+1000003*self.epoch+index)
+        levels=rng.sample(self.levels,self.k)
+        scenes=rng.sample(self.scenes,self.batch_images(index)//self.k)
+        # Capturing groups are not inferred from numeric prefixes. If verified
+        # grouping leaves no legal negatives, the miner explicitly skips them.
+        return [[self.by_scene[scene][level] for level in levels] for scene in scenes]
+
+    def __getitem__(self,index):
+        images,targets,levels,contents,groups,names=[],[],[],[],[],[]
+        for indices in self.plan(index):
+            first=load_rgb(self.records[indices[0]].input_path)
+            w,h=first.size
+            crop=(random.randint(0,max(0,h-self.patch_size)),random.randint(0,max(0,w-self.patch_size)))
+            augment=tuple(random.random()<.5 for _ in range(3)) if self.augment else (False,)*3
+            for record_index in indices:
+                record=self.records[record_index]
+                low=load_rgb(record.input_path)
+                if low.size!=(w,h): raise ValueError('PK positives must be registered at matching resolution.')
+                low,gt=transform_pair(low,load_rgb(record.gt_path),patch_size=self.patch_size,crop=crop,augment=augment)
+                images.append(low);targets.append(gt);levels.append([(record.level-1)/9])
+                contents.append(record.content_id);groups.append(record.group_id);names.append(record.filename)
+        return dict(low=torch.stack(images),gt=torch.stack(targets),levels=torch.tensor(levels,dtype=torch.float32),
+            content_ids=contents,group_ids=groups,filenames=names,
+            raw_levels=[self.records[i].level for indices in self.plan(index) for i in indices],layout='pk')
