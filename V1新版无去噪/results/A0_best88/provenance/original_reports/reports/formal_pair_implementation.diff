+    result=dict(status='PASS',configs={c['variant']:c for c in configs},
+        config_differences=[dict(field=k,A0=x,A1=y) for k,x,y in (
+            ('variant','A0','A1'),('run_dir',configs[0]['run_dir'],configs[1]['run_dir']),('model.affine_mode','bounded','standard'))],
+        manifest_hashes=hashes[0],seed=42,common_initial_parameters_exact=True,
+        common_state_sha256=digest.hexdigest(),bounded_only_parameters={k:first[k].item() for k in extra},
+        parameters={'A0':sum(p.numel() for p in a.parameters()),'A1':sum(p.numel() for p in b.parameters())},
+        git_head=version,source_sha256=source_hashes(),executable=sys.executable,torch=torch.__version__,
+        cuda=torch.version.cuda,gpu=torch.cuda.get_device_name() if torch.cuda.is_available() else 'NA',
+        per_epoch=dict(anchor_images=300,image_exposures=900,update_attempts=150),
+        per_variant=dict(epochs=100,image_exposures=90000,update_attempts=15000),
