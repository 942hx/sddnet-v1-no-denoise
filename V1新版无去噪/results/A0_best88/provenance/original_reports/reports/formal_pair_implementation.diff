+from utils.experiment import (experiment_config,assert_environment,run_path,active_project_runs,
+    manifest_identity,validate_formal_checkpoint,object_hash,training_contract,read_json,file_hash)
+from utils.runtime import PROJECT_ROOT,project_path,load_checkpoint,seed_everything
+from utils.io import write_json,read_csv
+
+PLAN='reports/formal_pair_preflight/plan.json'
+
+
+def source_hashes():
+    """Small reproducibility manifest, without datasets, weights or exported materials."""
+    files=[]
+    for folder in ('models','losses','datasets','engine','utils','scripts','tests'):
+        files.extend((PROJECT_ROOT/folder).glob('*.py'))
+    files.extend((PROJECT_ROOT/'configs').rglob('*.yaml'))
+    files.extend(PROJECT_ROOT/name for name in ('README.md','requirements.txt','requirements-lock.txt','scripts/run_A0_A1_train_only.bat'))
+    return {str(p.relative_to(PROJECT_ROOT)).replace('\\','/'):file_hash(p) for p in sorted(files) if p.is_file()}
+
+
+def pair_configs():
+    """Fail if any numerical setting beyond the single FiLM formula differs."""
+    configs=[experiment_config(f'configs/ablations/{v}.yaml') for v in ('A0','A1')]
+    stripped=[]
+    for cfg,mode in zip(configs,('bounded','standard')):
+        if (cfg['seed'],cfg['epochs'],cfg['patch_size'],cfg['triplet_batch_size'],cfg['accumulation_steps'])!=(42,100,256,1,2):
+            raise ValueError('Formal pair must use the prescribed seed/epochs/patch/triplet/accumulation.')
+        if cfg['model']!=dict(affine_mode=mode,local_init_std=.001,residual_gate=False,g_min=.25):
+            raise ValueError('Unexpected model/initialization/gate factor in formal pair.')
+        if cfg['sampling']!={'mode':'triplet'} or cfg['loss']['mining_mode']!='fixed':
+            raise ValueError('Formal pair must retain fixed triplet sampling, not PK/mining/batch ablations.')
+        item=copy.deepcopy(cfg);item.pop('variant');item.pop('run_dir');item['model'].pop('affine_mode');stripped.append(item)
+    if stripped[0]!=stripped[1]:raise ValueError('A0/A1 differ beyond variant/run_dir/affine_mode.')
+    return configs
+
+
+def plan(output):
+    """Lock the checked common initialization/config/data/code before fresh training."""
+    configs=pair_configs()
+    if active_project_runs():raise RuntimeError('A project run is active; no formal pair plan started.')
+    output=project_path(output)
+    if output.exists() and any(output.iterdir()):raise FileExistsError('Preserve existing plan; choose a new directory.')
+    hashes=[]
+    for cfg in configs:
+        assert_environment(cfg);guard_fresh(cfg,check_plan=False)
+        audit=read_json(run_path(cfg)/'data_audit.json')
+        if set(audit['splits'])!={'mill/train','mill/validation'}:
+            raise ValueError('Formal development audit must contain only MILL train/validation.')
+        if [audit['splits']['mill/'+s]['valid_pairs'] for s in ('train','validation')]!=[300,120]:
+            raise ValueError('Expected complete audited MILL train=300, validation=120.')
+        hashes.append(manifest_identity(cfg))
